<Window x:Class="DriveDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveDesk" Width="900" Height="600"
        WindowStartupLocation="CenterScreen" Background="#12161C">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1A2029" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Выйти" Click="Logout_Click" Padding="14,6"
                        Background="#232B36" Foreground="#E6EAF0" BorderBrush="#2C3644"/>
                <TextBlock Text="DriveDesk" FontSize="20" FontWeight="Bold" Foreground="#F5B700" VerticalAlignment="Center"/>
                <TextBlock x:Name="UserInfo" Foreground="#E6EAF0" Margin="24,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#1A2029" Padding="20,8">
            <TextBlock x:Name="Footer" Foreground="#8B97A8"/>
        </Border>
        <StackPanel Margin="20">
            <TextBlock x:Name="ListTitle" Foreground="#E6EAF0" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <DataGrid x:Name="StudentsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#1A2029" Foreground="#E6EAF0" RowBackground="#1A2029"
                      AlternatingRowBackground="#232B36" BorderBrush="#2C3644" GridLinesVisibility="None"
                      HeadersVisibility="Column" CanUserAddRows="False" Height="420">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="*"/>
                    <DataGridTextColumn Header="Инструктор" Binding="{Binding Instructor}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>
