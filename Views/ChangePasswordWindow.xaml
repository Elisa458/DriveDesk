<Window x:Class="DriveDesk.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Width="380" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#12161C">
    <StackPanel Margin="32" VerticalAlignment="Center">
        <TextBlock Text="Смена пароля" FontSize="22" FontWeight="Bold" Foreground="#F5B700"/>
        <TextBlock Text="Вы вошли с временным паролем. Задайте свой: от 8 символов, буква и цифра."
                   Foreground="#8B97A8" TextWrapping="Wrap" Margin="0,6,0,18"/>
        <TextBlock Text="Новый пароль" Foreground="#8B97A8"/>
        <PasswordBox x:Name="NewPwd" Margin="0,4,0,12" Padding="8" Background="#232B36" Foreground="#E6EAF0" BorderBrush="#2C3644"/>
        <TextBlock Text="Повторите пароль" Foreground="#8B97A8"/>
        <PasswordBox x:Name="RepeatPwd" Margin="0,4,0,12" Padding="8" Background="#232B36" Foreground="#E6EAF0" BorderBrush="#2C3644"/>
        <TextBlock x:Name="Err" Foreground="#EF5B5B" TextWrapping="Wrap" MinHeight="36"/>
        <Button Content="Сохранить" Click="Save_Click" IsDefault="True"
                Background="#F5B700" Foreground="#12161C" FontWeight="SemiBold" Padding="0,10" BorderThickness="0"/>
    </StackPanel>
</Window>
